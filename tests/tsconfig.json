{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["playwright.config.ts", "api/**/*.ts", "ui-local/**/*.ts", "e2e/**/*.ts", "harness/**/*.ts", "inventory/**/*.ts", "support/**/*.ts", "../src/shared/contracts.ts"],
  "exclude": ["node_modules", "artifacts"]
}
